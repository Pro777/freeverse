---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SemanticSearchLab from "../../components/SemanticSearchLab.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const corpusUrl = `${base}api/freeverse-public-corpus.jsonl`;
const modelId = "Xenova/paraphrase-multilingual-MiniLM-L12-v2";
---

<BaseLayout
  title="Semantic Search Lab · Freeverse"
  description="Experimental proof that Freeverse can run multilingual semantic search in the browser against a static public corpus export."
  currentPath="/labs/semantic-search/"
>
  <SemanticSearchLab corpusUrl={corpusUrl} modelId={modelId} maxDocs={180} />
</BaseLayout>
