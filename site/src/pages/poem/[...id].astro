---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadRelatedPoems } from "../../lib/collections";
import { loadPoemMetas, loadPoemText, type PoemMeta } from "../../lib/poems";
import { AUTHOR_INFO } from "../../lib/authors";
import { authorPath } from "../../lib/url";
// (tests) line-link hash logic is unit-tested separately in src/lib/lineLinks.ts

export async function getStaticPaths() {
  const poems = await loadPoemMetas();
  return poems.map((p) => ({
    // For rest params, Astro expects a single string that may contain slashes.
    params: { id: p.id },
    props: { poem: p },
  }));
}

type Props = { poem: PoemMeta };

const { poem } = Astro.props;
const raw = await loadPoemText(poem);
const lines = raw ? raw.split(/\r?\n/) : [];
const relatedPoems = await loadRelatedPoems(poem.id);

const title = `${poem.author} — ${poem.title} · Freeverse`;
const description = `Read ${poem.title} by ${poem.author}.`;

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const canonicalPath = `${base}poem/${poem.id}/`;
const canonicalUrl = Astro.site ? new URL(canonicalPath, Astro.site).toString() : undefined;
const authorUrl = Astro.site ? new URL(authorPath(base, poem.author_slug), Astro.site).toString() : undefined;
const authorInfo = AUTHOR_INFO[poem.author_slug];
const excerpt = lines
  .slice(0, Math.max(lines.findIndex((line) => line === ""), 0) || Math.min(lines.length, 8))
  .join("\n")
  .trim();
const poemStructuredData = {
  "@context": "https://schema.org",
  "@type": "Poem",
  "@id": canonicalUrl ? `${canonicalUrl}#poem` : undefined,
  name: poem.title,
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  author: {
    "@type": "Person",
    name: poem.author,
    url: authorUrl,
    sameAs: authorInfo?.source_url,
  },
  inLanguage: poem.text_locale,
  isAccessibleForFree: true,
  description,
  text: excerpt || undefined,
  translator: poem.translator
    ? {
        "@type": "Person",
        name: poem.translator,
      }
    : undefined,
  isPartOf: poem.translation_of
    ? {
        "@type": "CreativeWork",
        identifier: poem.translation_of,
      }
    : undefined,
};
---

<BaseLayout
  title={title}
  description={description}
  currentPath={""}
  structuredData={poemStructuredData}
>
  <article
    class="reader"
    data-poem-id={poem.id}
    data-poem-title={poem.title}
    data-poem-author={poem.author}
    data-share-base={base}
  >
    <header class="reader-head">
      <div class="reader-head-row">
        <h1 class="reader-title">{poem.title}</h1>
        <div class="reader-actions">
          <div class="reader-mode-toggle" role="group" aria-label="Reader mode">
            <button type="button" class="reader-mode-btn" data-reader-mode-value="clean" aria-pressed="false">
              Clean page
            </button>
            <button type="button" class="reader-mode-btn" data-reader-mode-value="scholar" aria-pressed="false">
              Scholar mode
            </button>
          </div>
          <button
            class="star-btn"
            type="button"
            aria-label="Add to favorites"
            aria-pressed="false"
            data-poem-id={poem.id}
          >
            <svg class="star-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="22" height="22">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </button>
        </div>
      </div>
      <p class="reader-byline">
        <span class="muted">by</span>{' '}
        <a href={authorPath(base, poem.author_slug)}>
          <strong>{poem.author}</strong>
        </a>
        <span class="muted" style="margin: 0 0.35rem;">·</span>
        <a class="muted" href={`${base}browse/`}>Explore poems</a>
      </p>
    </header>

    {raw ? (
      <>
        <p id="poem-reader-instructions" class="sr-only">
          Use Tab to move through poem lines. Press Enter or Space to select a line. Hold Shift while selecting a second line to create a shared range.
        </p>
        <ol
          class="poem-lines"
          aria-label="Poem"
          aria-describedby="poem-reader-instructions"
          lang={poem.text_locale}
          dir={poem.text_direction}
        >
        {lines.map((line, idx) => {
          const n = idx + 1;
          const id = `l${n}`;
          const isBlank = line === "";
          return (
            <li
              id={id}
              data-line={n}
              class={isBlank ? "is-blank" : ""}
              aria-label={isBlank ? "Stanza break" : undefined}
              tabindex={isBlank ? undefined : 0}
            >
              <span class="line-anchor" aria-hidden="true" data-line={n}></span>
              <span class="line-text">{isBlank ? "\u00A0" : line}</span>
            </li>
          );
        })}
        </ol>
        {poem.text_locale !== "en" || poem.original_language !== "en" || poem.translator ? (
          <p class="muted" style="margin: 0.9rem 0 0;">
            Text language: <strong>{poem.text_locale}</strong>
            {poem.original_language !== poem.text_locale ? ` · Original language: ${poem.original_language}` : ""}
            {poem.translator ? ` · Translator: ${poem.translator}` : ""}
          </p>
        ) : null}
      </>
    ) : (
      <div class="card">
        <p class="muted" style="margin:0;">
          Poem text isn't in the repository yet.
          {poem.source_url ? (
            <>
              {" "}Try the source: <a href={poem.source_url}>{poem.source_label ?? poem.source_url}</a>.
            </>
          ) : null}
        </p>
      </div>
    )}

    <footer class="reader-foot muted">
      <p style="margin:0.9rem 0 0;">
        Tip: click a line to share it — or shift-click another line to share a range.
      </p>
    </footer>

    {relatedPoems.length > 0 ? (
      <section class="card related-readings" aria-labelledby="related-readings-title">
        <div class="kicker">
          <h2 id="related-readings-title">Related readings</h2>
          <span class="pill">{relatedPoems.length} suggestion{relatedPoems.length === 1 ? "" : "s"}</span>
        </div>
        <ul class="list related-readings-list">
          {relatedPoems.map(({ poem: relatedPoem, reason }) => (
            <li>
              <p style="margin: 0;">
                <a class="list-title" href={`${base}poem/${relatedPoem.id}/`}>
                  <strong>{relatedPoem.title}</strong>
                </a>
              </p>
              <p class="muted related-reading-meta">
                <a href={authorPath(base, relatedPoem.author_slug)}>{relatedPoem.author}</a>
                <span class="related-reading-dot">·</span>
                <span>{reason}</span>
              </p>
            </li>
          ))}
        </ul>
      </section>
    ) : null}

    <section class="quote-card-tools" data-quote-card-tools hidden aria-live="polite">
      <div>
        <p class="quote-card-tools-label">Selected passage</p>
        <p class="quote-card-tools-range" data-selected-range>Choose a line range to generate a quote card.</p>
      </div>
      <div class="quote-card-tools-actions">
        <button type="button" class="quote-card-action" data-copy-range-link>
          Copy range link
        </button>
        <button type="button" class="quote-card-action quote-card-action-primary" data-open-quote-card>
          Open quote card
        </button>
      </div>
    </section>

    <div class="quote-card-modal" data-quote-card-modal hidden>
      <div class="quote-card-backdrop" data-close-quote-card></div>
      <section
        class="quote-card-panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="quote-card-title"
      >
        <button type="button" class="quote-card-close" data-close-quote-card aria-label="Close quote card">
          Close
        </button>
        <p class="quote-card-kicker" id="quote-card-title">Quote card preview</p>
        <article class="quote-card-preview" data-quote-card-preview>
          <p class="quote-card-preview-range" data-quote-card-range></p>
          <blockquote class="quote-card-preview-text" data-quote-card-text></blockquote>
          <p class="quote-card-preview-meta">
            <span data-quote-card-author></span>
            <span class="quote-card-preview-dot">·</span>
            <span data-quote-card-title-text></span>
          </p>
          <p class="quote-card-preview-link" data-quote-card-link></p>
        </article>
        <div class="quote-card-panel-actions">
          <button type="button" class="quote-card-action" data-copy-quote-card-text>
            Copy card text
          </button>
          <button type="button" class="quote-card-action quote-card-action-primary" data-native-share>
            Share card
          </button>
        </div>
      </section>
    </div>

    <script is:inline>
      // NOTE: URL fragment helpers are unit-tested in site/src/lib/lineLinks.ts.
      // This inline script intentionally keeps its own lightweight parsing/building
      // to avoid bundling surprises in the static output.
      (() => {
        const article = document.querySelector('.reader[data-poem-id]');
        if (!article) return;

        const READER_MODE_STORAGE_KEY = 'freeverse-reader-mode';
        const lines = Array.from(document.querySelectorAll('.poem-lines li'));
        if (!lines.length) return;
        const readerModeButtons = Array.from(document.querySelectorAll('.reader-mode-btn'));
        const quoteCardTools = document.querySelector('[data-quote-card-tools]');
        const selectedRangeLabel = document.querySelector('[data-selected-range]');
        const copyRangeLinkButton = document.querySelector('[data-copy-range-link]');
        const openQuoteCardButton = document.querySelector('[data-open-quote-card]');
        const quoteCardModal = document.querySelector('[data-quote-card-modal]');
        const quoteCardText = document.querySelector('[data-quote-card-text]');
        const quoteCardRange = document.querySelector('[data-quote-card-range]');
        const quoteCardAuthor = document.querySelector('[data-quote-card-author]');
        const quoteCardTitle = document.querySelector('[data-quote-card-title-text]');
        const quoteCardLink = document.querySelector('[data-quote-card-link]');
        const copyQuoteCardTextButton = document.querySelector('[data-copy-quote-card-text]');
        const nativeShareButton = document.querySelector('[data-native-share]');
        const closeQuoteCardButtons = Array.from(document.querySelectorAll('[data-close-quote-card]'));
        const quoteCardPanel = document.querySelector('[data-quote-card-modal] .quote-card-panel');
        const quoteCardCloseButton = document.querySelector('[data-close-quote-card].quote-card-close');
        const poemId = article.dataset.poemId || '';
        const poemTitle = article.dataset.poemTitle || '';
        const poemAuthor = article.dataset.poemAuthor || '';
        const shareBase = article.dataset.shareBase || '/';
        let lastFocusedElement = null;

        const applyReaderMode = (mode) => {
          const nextMode = mode === 'scholar' ? 'scholar' : 'clean';
          document.documentElement.dataset.readerMode = nextMode;
          readerModeButtons.forEach((button) => {
            const active = button.dataset.readerModeValue === nextMode;
            button.setAttribute('aria-pressed', String(active));
          });
          try {
            localStorage.setItem(READER_MODE_STORAGE_KEY, nextMode);
          } catch {}
        };

        readerModeButtons.forEach((button) => {
          button.addEventListener('click', () => applyReaderMode(button.dataset.readerModeValue));
        });

        applyReaderMode(document.documentElement.dataset.readerMode);

        const clear = () => {
          lines.forEach((li) => li.classList.remove('is-selected'));
        };

        const parseHash = () => {
          const h = (location.hash || '').replace(/^#/, '');
          if (!h) return null;

          const m = h.match(/^l(\d+)(?:-l(\d+))?$/);
          if (!m) return null;

          const a = Number(m[1]);
          const b = m[2] ? Number(m[2]) : a;
          if (!Number.isFinite(a) || !Number.isFinite(b)) return null;

          const start = Math.min(a, b);
          const end = Math.max(a, b);
          return { start, end };
        };

        const scrollRangeIntoView = (range) => {
          if (!range) return;

          const target = document.getElementById(`l${range.start}`);
          if (!target) return;

          target.scrollIntoView({
            block: 'center',
            inline: 'nearest',
            behavior: window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches
              ? 'auto'
              : 'smooth',
          });
        };

        const applyFromHash = ({ scroll = false } = {}) => {
          clear();
          const r = parseHash();
          syncQuoteCardState(r);
          if (!r) {
            if (quoteCardModal) quoteCardModal.hidden = true;
            document.body.classList.remove('quote-card-open');
            return;
          }

          // Make shift-click extend the current selection, even after refresh/back/forward.
          startLine = r.start;

          for (let n = r.start; n <= r.end; n++) {
            const el = document.getElementById(`l${n}`);
            if (el) el.classList.add('is-selected');
          }

          if (scroll) scrollRangeIntoView(r);
        };

        let startLine = null;

        const toast = (() => {
          let el = document.getElementById('toast');
          if (!el) {
            el = document.createElement('div');
            el.id = 'toast';
            el.className = 'toast';
            el.setAttribute('role', 'status');
            el.setAttribute('aria-live', 'polite');
            document.body.appendChild(el);
          }

          let t;
          return (msg) => {
            el.textContent = msg;
            el.classList.add('is-visible');
            clearTimeout(t);
            t = setTimeout(() => el.classList.remove('is-visible'), 1200);
          };
        })();

        const buildShareUrl = (start, end) => {
          const s = Math.min(start, end);
          const e = Math.max(start, end);
          // Selection-aware, crawler-visible URL (static prebuilt for short ranges).
          return new URL(`${shareBase}share/${encodeURIComponent(poemId)}/${s}-${e}/`, location.origin).toString();
        };

        const formatRangeLabel = (start, end) => {
          const s = Math.min(start, end);
          const e = Math.max(start, end);
          return s === e ? `Line ${s}` : `Lines ${s}-${e}`;
        };

        const getRangeText = (start, end) => {
          const excerpt = [];
          for (let n = Math.min(start, end); n <= Math.max(start, end); n += 1) {
            const line = document.getElementById(`l${n}`);
            if (!line) continue;
            excerpt.push(line.classList.contains('is-blank') ? '' : (line.querySelector('.line-text')?.textContent ?? ''));
          }
          return excerpt.join('\n').trimEnd();
        };

        const buildQuoteCardPayload = (start, end) => {
          const rangeLabel = formatRangeLabel(start, end);
          const excerpt = getRangeText(start, end);
          const url = buildShareUrl(start, end);
          const shareText = `"${excerpt}"\n\n${poemTitle} — ${poemAuthor}\n${rangeLabel}\n${url}`;
          return { rangeLabel, excerpt, url, shareText };
        };

        const syncQuoteCardState = (range) => {
          if (!quoteCardTools || !selectedRangeLabel || !copyRangeLinkButton || !openQuoteCardButton) return;

          if (!range) {
            quoteCardTools.hidden = true;
            selectedRangeLabel.textContent = 'Choose a line range to generate a quote card.';
            copyRangeLinkButton.disabled = true;
            openQuoteCardButton.disabled = true;
            return;
          }

          const payload = buildQuoteCardPayload(range.start, range.end);
          quoteCardTools.hidden = false;
          selectedRangeLabel.textContent = `${payload.rangeLabel} ready to share`;
          copyRangeLinkButton.disabled = false;
          openQuoteCardButton.disabled = false;

          if (quoteCardText) quoteCardText.textContent = payload.excerpt;
          if (quoteCardRange) quoteCardRange.textContent = payload.rangeLabel;
          if (quoteCardAuthor) quoteCardAuthor.textContent = poemAuthor;
          if (quoteCardTitle) quoteCardTitle.textContent = poemTitle;
          if (quoteCardLink) quoteCardLink.textContent = payload.url.replace(location.origin, '');
        };

        // Keep UI in sync when navigating back/forward.
        window.addEventListener('hashchange', () => applyFromHash({ scroll: true }));
        applyFromHash({ scroll: true });

        const copyUrl = async (start, end) => {
          const url = (start && end) ? buildShareUrl(start, end) : location.href;
          const hasRange = Number.isFinite(start) && Number.isFinite(end);
          const s = hasRange ? Math.min(start, end) : null;
          const e = hasRange ? Math.max(start, end) : null;
          const selectionLabel = (s && e)
            ? (s === e ? `line ${s}` : `lines ${s}-${e}`)
            : 'link';
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              await navigator.clipboard.writeText(url);
              toast(`Copied link to ${selectionLabel}`);
            } else {
              toast('Link ready (copy from address bar)');
            }
          } catch {
            toast('Link ready (copy from address bar)');
          }
        };

        const setHash = async (start, end) => {
          const fragment = start === end ? `#l${start}` : `#l${start}-l${end}`;
          history.replaceState(null, '', fragment);
          applyFromHash({ scroll: false });
          await copyUrl(start, end);
        };

        const closeQuoteCard = () => {
          if (!quoteCardModal) return;
          quoteCardModal.hidden = true;
          document.body.classList.remove('quote-card-open');
          if (lastFocusedElement instanceof HTMLElement) lastFocusedElement.focus();
        };

        const openQuoteCard = () => {
          const range = parseHash();
          if (!range || !quoteCardModal) return;
          syncQuoteCardState(range);
          lastFocusedElement = document.activeElement;
          quoteCardModal.hidden = false;
          document.body.classList.add('quote-card-open');
          if (quoteCardCloseButton instanceof HTMLElement) quoteCardCloseButton.focus();
        };

        closeQuoteCardButtons.forEach((button) => {
          button.addEventListener('click', closeQuoteCard);
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Tab' && quoteCardModal && !quoteCardModal.hidden && quoteCardPanel instanceof HTMLElement) {
            const focusable = Array.from(
              quoteCardPanel.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])')
            ).filter((el) => el instanceof HTMLElement && !el.hasAttribute('disabled'));
            if (focusable.length) {
              const first = focusable[0];
              const last = focusable[focusable.length - 1];
              if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first.focus();
              } else if (event.shiftKey && document.activeElement === first) {
                event.preventDefault();
                last.focus();
              }
            }
          }
          if (event.key === 'Escape') closeQuoteCard();
        });

        copyRangeLinkButton?.addEventListener('click', async () => {
          const range = parseHash();
          if (!range) return;
          await copyUrl(range.start, range.end);
        });

        openQuoteCardButton?.addEventListener('click', openQuoteCard);

        copyQuoteCardTextButton?.addEventListener('click', async () => {
          const range = parseHash();
          if (!range) return;
          const payload = buildQuoteCardPayload(range.start, range.end);
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              await navigator.clipboard.writeText(payload.shareText);
              toast(`Copied quote card for ${payload.rangeLabel.toLowerCase()}`);
            } else {
              toast('Quote card ready to copy');
            }
          } catch {
            toast('Quote card ready to copy');
          }
        });

        nativeShareButton?.addEventListener('click', async () => {
          const range = parseHash();
          if (!range) return;
          const payload = buildQuoteCardPayload(range.start, range.end);
          if (navigator.share) {
            try {
              await navigator.share({
                title: `${poemTitle} — ${payload.rangeLabel}`,
                text: `"${payload.excerpt}"\n\n${poemTitle} — ${poemAuthor}`,
                url: payload.url,
              });
            } catch {}
            return;
          }

          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              await navigator.clipboard.writeText(payload.shareText);
              toast(`Copied quote card for ${payload.rangeLabel.toLowerCase()}`);
            }
          } catch {
            toast('Share unavailable on this browser');
          }
        });

        document.addEventListener('click', (e) => {
          const li = e.target && e.target.closest ? e.target.closest('.poem-lines li[id^="l"]') : null;
          if (!li || !li.id) return;
          if (li.classList.contains('is-blank')) return;

          // Don't hijack clicks on real links inside the poem (if we add any later).
          const isLink = e.target && e.target.closest ? e.target.closest('a') : null;
          if (isLink) return;

          const n = Number(li.id.replace(/^l/, ''));
          if (!Number.isFinite(n)) return;

          if (e.shiftKey) {
            if (startLine == null) {
              const r = parseHash();
              if (r) startLine = r.start;
            }
            if (startLine != null) {
              void setHash(startLine, n);
              return;
            }
          }

          startLine = n;
          void setHash(n, n);
        });

        document.addEventListener('keydown', (e) => {
          const li = e.target && e.target.closest ? e.target.closest('.poem-lines li[id^="l"]') : null;
          if (!li || !li.id || li.classList.contains('is-blank')) return;
          if (e.key !== 'Enter' && e.key !== ' ') return;

          e.preventDefault();

          const n = Number(li.id.replace(/^l/, ''));
          if (!Number.isFinite(n)) return;

          if (e.shiftKey) {
            if (startLine == null) {
              const r = parseHash();
              if (r) startLine = r.start;
            }
            if (startLine != null) {
              void setHash(startLine, n);
              return;
            }
          }

          startLine = n;
          void setHash(n, n);
        });
      })();
    </script>

    <script>
      // Favorites / star button
      import { getFavorites, toggleFavorite, dispatchFavoritesChange } from '../../lib/favorites';

      const btn = document.querySelector<HTMLButtonElement>('.star-btn[data-poem-id]');
      if (btn) {
        const poemId = btn.dataset.poemId!;

        const sync = () => {
          const starred = getFavorites().includes(poemId);
          btn.setAttribute('aria-pressed', String(starred));
          btn.setAttribute('aria-label', starred ? 'Remove from favorites' : 'Add to favorites');
          btn.classList.toggle('is-starred', starred);
        };

        sync();

        btn.addEventListener('click', () => {
          toggleFavorite(poemId);
          sync();
          dispatchFavoritesChange();
        });

        // React if another tab/page changes favorites.
        window.addEventListener('storage', sync);
        window.addEventListener('freeverse:favorites-change', sync);
      }
    </script>
  </article>
</BaseLayout>
